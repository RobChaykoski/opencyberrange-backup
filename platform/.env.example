# ============================================================
# OpenCyberRange Platform — Environment Configuration
# ============================================================
# Copy this file to .env and fill in ALL values before starting.
#
#   cp .env.example .env
#
# Generate secrets with:
#   JWT_SECRET:       python3 -c "import secrets; print(secrets.token_hex(32))"
#   SETUP_TOKEN:      python3 -c "import secrets; print(secrets.token_hex(32))"
#   WG_API_KEY:       python3 -c "import secrets; print(secrets.token_hex(32))"
#   WG_ENCRYPTION_KEY: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   POSTGRES_PASSWORD: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# ============================================================

# --- Authentication ---
JWT_SECRET=CHANGE_ME_generate_with_token_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# One-time first-run token required to create the first administrator.
# Leave empty only on a fully isolated network. Delete the line after setup.
SETUP_TOKEN=CHANGE_ME_generate_with_token_hex_32

# Allowed browser origins (comma-separated). Include the address students use.
CORS_ORIGINS=https://localhost,http://localhost

# --- Database ---
POSTGRES_USER=labuser
POSTGRES_PASSWORD=CHANGE_ME_generate_strong_password
POSTGRES_DB=labdb
DATABASE_URL=postgresql://labuser:CHANGE_ME_same_as_above@db:5432/labdb

# --- WireGuard VPN ---
WG_SERVER_ENDPOINT=YOUR_SERVER_IP:51820
WG_SERVER_PUBLIC_KEY=YOUR_WG_SERVER_PUBLIC_KEY
WG_API_URL=http://host.docker.internal:5000
WG_API_KEY=CHANGE_ME_generate_with_token_hex_32
WG_ENCRYPTION_KEY=CHANGE_ME_generate_fernet_key
WG_NETWORK_BASE=10.100
# 3-octet base ("10.0.0") gives one /24, about 245 peers. For a larger peer
# pool use "10.0" and set VPN_SERVER_ADDRESS=10.0.0.1/16 in setup-range-server.
WG_CLIENT_BASE=10.0.0

# --- Deployment ---
# "local" = LAN-only (self-signed cert, VPN endpoint is LAN IP)
# "internet" = public-facing (VPN endpoint is public IP, optional Cloudflare/WSTunnel)
DEPLOYMENT_MODE=internet
# Address students use in the browser (IP or domain). Used in generated links.
SERVER_PUBLIC_HOST=YOUR_SERVER_IP_OR_DOMAIN

# --- Data protection / erasure ---
# Append-only suppression ledger for deleted accounts. Keep it on a persistent
# volume and outside PostgreSQL so a database restore cannot overwrite it.
ERASURE_LEDGER_PATH=/workbook/erasure-ledger.jsonl
# Optional dedicated key for ledger hashes. Leave empty to use JWT_SECRET.
# Changing this value invalidates existing entries; keep it stable.
ERASURE_LEDGER_KEY=

# --- Labs ---
# Absolute path on the HOST to the platform/labs/ directory.
# Docker needs this to mount lab volumes into containers.
# The setup script fills this automatically during installation.
# Example: /opt/opencyberrange/platform/labs
LABS_HOST_PATH=

# --- Rate limiting ---
# Shared counter backend for slowapi. The bundled redis service is the default.
# Use "memory://" only for a single-worker development instance; with multiple
# workers, memory counters multiply the effective limit per process.
RATELIMIT_STORAGE_URI=redis://redis:6379/0
